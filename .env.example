# 复制为 .env 后填写（.env 已被 gitignore，勿提交真实 Key）。
# 程序启动时会可选加载 .env，且不覆盖已在 shell 中设置的变量。
#
# 也可用 shell 直接设置：
#   Linux/macOS:  export DEEPSEEK_API_KEY="sk-..."
#   PowerShell:   $env:DEEPSEEK_API_KEY = "sk-..."
#   CMD:          set DEEPSEEK_API_KEY=sk-...
#
# 用法: python read_books.py book.pdf

DEEPSEEK_API_KEY=
# READ_BOOKS_PROFILE=auto
