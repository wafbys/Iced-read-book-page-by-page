# 仅作说明模板：在 shell / 系统环境变量里设置，不要填真实 Key 后提交。
#
# Flash / Pro 共用这一把 Key；选模型用命令行 --model / --analysis-model。
#
# ========== Windows 当前会话 ==========
# PowerShell:
#   $env:DEEPSEEK_API_KEY = "sk-..."
# CMD:
#   set DEEPSEEK_API_KEY=sk-...
#
# ========== Windows 永久（用户级）==========
# PowerShell:
#   [System.Environment]::SetEnvironmentVariable("DEEPSEEK_API_KEY", "sk-...", "User")
#   $env:DEEPSEEK_API_KEY = [System.Environment]::GetEnvironmentVariable("DEEPSEEK_API_KEY", "User")
# CMD（新开终端后生效）:
#   setx DEEPSEEK_API_KEY "sk-..."
#
# ========== macOS / Linux 会话 ==========
#   export DEEPSEEK_API_KEY="sk-..."
#
# 详见 README「配置 API Key」。

DEEPSEEK_API_KEY=
