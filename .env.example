# 仅作说明模板：在 shell 里设置同名环境变量。
# 不要把真实 Key 写进本文件，也不要提交 .env。
#
# Flash / Pro 共用这一把 Key；选模型请用命令行：
#   --model deepseek-v4-flash   （默认，快/省）
#   --model deepseek-v4-pro     （更强）
#   --analysis-model ...        （摘要可与逐页不同）
#
# Windows PowerShell:
#   $env:DEEPSEEK_API_KEY = "sk-..."
#   python read_books.py book.pdf
#   python read_books.py book.pdf --model deepseek-v4-pro
#
# macOS / Linux:
#   export DEEPSEEK_API_KEY="sk-..."
#   python read_books.py book.pdf

DEEPSEEK_API_KEY=
